# h2load with HTTP/3, plus a curl that speaks h3 and a QUIC client that can
# force a NAT rebinding. Built on node3.
#
# There is no maintained upstream image that ships h2load with QUIC, so this
# assembles the stack: aws-lc (QUIC-capable TLS) -> nghttp3 (HTTP/3) ->
# ngtcp2 (QUIC transport) -> nghttp2 (h2load itself) -> curl.
#
# Base is Debian 13 (trixie), NOT bookworm: ngtcp2's example client now requires
# a C++23 compiler, and bookworm's g++ 12 silently disables the examples
# ("Examples: no" in the configure summary) while still building the library
# fine. trixie's default g++-14 has C++23. Do not "simplify" this back to
# bookworm or add a testing-repo pin -- mixing suites gives you a newer gcc that
# is not the default g++, which configure ignores.
#
# Tags are resolved to the newest release at build time rather than pinned, so
# this does not rot. Record the resolved versions from the build log alongside
# your results -- they are part of the experiment's provenance.
FROM debian:trixie AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
      autoconf automake autotools-dev libtool pkg-config ca-certificates \
      build-essential cmake ninja-build git curl golang \
      zlib1g-dev libev-dev libc-ares-dev libjemalloc-dev libxml2-dev \
 && rm -rf /var/lib/apt/lists/*

# ngtcp2's configure runs a full C++23 feature probe, not just a version check,
# and silently sets "Examples: no" when it fails -- which is only discovered
# 25 minutes later when the example client is missing. Select the newest g++
# available and prove it compiles C++23 before anything else runs.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends g++-15 || apt-get install -y --no-install-recommends g++-14 || apt-get install -y --no-install-recommends g++-13 || true; \
    rm -rf /var/lib/apt/lists/*; \
    best="$(ls -1 /usr/bin/g++-* 2>/dev/null | sort -V | tail -1 || true)"; \
    [ -n "$best" ] || best=/usr/bin/g++; \
    ln -sf "$best" /usr/local/bin/g++; \
    echo "selected $best ($(/usr/local/bin/g++ -dumpversion))"
ENV CXX=/usr/local/bin/g++

RUN set -eux; \
    printf '#include <expected>\n#include <print>\nint main(){return 0;}\n' > /tmp/t.cc; \
    "$CXX" -std=c++23 /tmp/t.cc -o /tmp/t; \
    rm -f /tmp/t.cc /tmp/t; \
    echo "C++23 OK with $($CXX -dumpversion)"

# newest_tag <repo-url> -> prints the highest semver tag
RUN printf '%s\n' '#!/bin/sh' \
      'git ls-remote --tags --refs --sort=-v:refname "$1" | head -1 | sed "s|.*refs/tags/||"' \
      > /usr/local/bin/newest_tag && chmod +x /usr/local/bin/newest_tag

RUN set -eux; \
    url=https://github.com/aws/aws-lc.git; t="$(newest_tag $url)"; echo "aws-lc $t"; \
    git clone --depth 1 -b "$t" "$url" /src/aws-lc; \
    cmake -B /src/aws-lc/build -S /src/aws-lc -GNinja \
      -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
      -DDISABLE_GO=ON -DBUILD_TESTING=OFF \
      -DCMAKE_INSTALL_PREFIX=/opt/awslc; \
    ninja -C /src/aws-lc/build install

ENV PKG_CONFIG_PATH=/opt/h3/lib/pkgconfig:/opt/awslc/lib/pkgconfig
ENV LD_LIBRARY_PATH=/opt/awslc/lib:/opt/h3/lib

RUN set -eux; \
    url=https://github.com/ngtcp2/nghttp3.git; t="$(newest_tag $url)"; echo "nghttp3 $t"; \
    git clone --depth 1 -b "$t" --recursive "$url" /src/nghttp3; \
    cd /src/nghttp3; autoreconf -i; \
    ./configure --prefix=/opt/h3 --enable-lib-only; \
    make -j"$(nproc)" && make install

# Examples are built deliberately (no --enable-lib-only): the example client is
# the only readily available QUIC client that can force a NAT rebinding on
# demand, which is what E4 needs to test connection migration. With the
# boringssl/aws-lc backend the binary is examples/bsslclient.
RUN set -eux; \
    url=https://github.com/ngtcp2/ngtcp2.git; t="$(newest_tag $url)"; echo "ngtcp2 $t"; \
    git clone --depth 1 -b "$t" --recursive "$url" /src/ngtcp2; \
    cd /src/ngtcp2; autoreconf -i; \
    ./configure --prefix=/opt/h3 --with-boringssl \
      BORINGSSL_CFLAGS="-I/opt/awslc/include" \
      BORINGSSL_LIBS="-L/opt/awslc/lib -lssl -lcrypto" \
      LDFLAGS="-Wl,-rpath,/opt/awslc/lib -Wl,-rpath,/opt/h3/lib"; \
    make -j"$(nproc)"; \
    make install; \
    if [ ! -x examples/bsslclient ]; then \
      echo "ERROR: ngtcp2 examples were not built." >&2; \
      echo "Look for 'Examples: no' in the configure summary above -- it means" >&2; \
      echo "the C++ compiler lacks C++23 and E4 would have no rebinding client." >&2; \
      exit 1; \
    fi; \
    install -m0755 examples/bsslclient /usr/local/bin/quic-client

RUN set -eux; \
    url=https://github.com/nghttp2/nghttp2.git; t="$(newest_tag $url)"; echo "nghttp2 $t"; \
    git clone --depth 1 -b "$t" --recursive "$url" /src/nghttp2; \
    cd /src/nghttp2; autoreconf -i; \
    ./configure --prefix=/usr/local --enable-app --enable-http3 --without-jemalloc \
      OPENSSL_CFLAGS="-I/opt/awslc/include" \
      OPENSSL_LIBS="-L/opt/awslc/lib -lssl -lcrypto" \
      LDFLAGS="-Wl,-rpath,/opt/awslc/lib -Wl,-rpath,/opt/h3/lib"; \
    make -j"$(nproc)" && make install

# curl with HTTP/3 over the same ngtcp2 stack, so the functional check and the
# load test exercise identical client-side QUIC behaviour.
RUN set -eux; \
    url=https://github.com/curl/curl.git; t="$(newest_tag $url)"; echo "curl $t"; \
    git clone --depth 1 -b "$t" "$url" /src/curl; \
    cd /src/curl; autoreconf -fi; \
    ./configure --prefix=/usr/local --with-openssl=/opt/awslc \
      --with-nghttp3=/opt/h3 --with-ngtcp2=/opt/h3 --without-libpsl \
      LDFLAGS="-Wl,-rpath,/opt/awslc/lib -Wl,-rpath,/opt/h3/lib"; \
    make -j"$(nproc)" && make install

FROM debian:trixie-slim
# The -dev packages are deliberate. Debian's 64-bit time_t transition renamed
# several runtime libs (libev4 -> libev4t64 and friends) and the names differ
# between releases; the -dev names have been stable. A few extra MB in a lab
# image is worth not having the runtime stage break on a package rename.
RUN apt-get update && apt-get install -y --no-install-recommends \
      zlib1g-dev libev-dev libc-ares-dev libxml2-dev ca-certificates jq \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/awslc/lib /opt/awslc/lib
COPY --from=build /opt/h3/lib    /opt/h3/lib
COPY --from=build /usr/local/bin /usr/local/bin
COPY --from=build /usr/local/lib /usr/local/lib
ENV LD_LIBRARY_PATH=/opt/awslc/lib:/opt/h3/lib:/usr/local/lib

# Assert the tools actually have HTTP/3 before this image is usable.
RUN set -eux; \
    ldconfig; \
    h2load --version; \
    curl --version | grep -q HTTP3; \
    quic-client --help > /tmp/qc 2>&1 || true; \
    grep -q nat-rebinding /tmp/qc; \
    rm -f /tmp/qc; \
    echo "h2load + curl have HTTP/3; quic-client can force rebinding"

ENTRYPOINT ["/bin/bash", "-lc"]
